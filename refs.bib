@techreport{rep-PIDRoadmap-26,
  title = {{{PID Roadmap}} for {{Research}} and {{Cultural Heritage Institutions}} in {{Germany}}},
  author = {Genderjahn, Steffi and Schrader, Antonia and Czerniak, Andreas and Fischer, Barbara Katharina and {Hagemann-Wilholt}, Stephanie and Vierkant, Paul and Vleugel, Mathijs and Ziedorn, Frauke},
  year = 2026,
  month = aug,
  institution = {PID Network Deutschland},
  doi = {10.5281/zenodo.21713802},
  urldate = {2026-09-28},
  abstract = {Permanent and reliable access to digital resources is a fundamental prerequisite for reproducible research and the preservation of cultural heritage. Although persistent identifiers (PIDs) are~recognized as core elements of Open Science and the FAIR principles, the German research and~cultural heritage sector is characterized by a lack of institutional commitment, discipline-specific fragmentation, and parallel federal structures. To systematically identify these hurdles, a~comprehensive empirical assessment was conducted as part of the DFG-funded project ``PID~Network Deutschland``. Based on this assessment, the present PID Roadmap establishes, for~the first time, a cross-disciplinary, practice-oriented framework for PID implementation in Germany. It consolidates the most pressing challenges of the next five years into five complemen-tary areas of action. It serves as a strategic roadmap that is to be translated into a binding national PID action plan through dialogue with research and cultural institutions, funding organizations, infrastructure operators,~and disciplinary communities.},
  langid = {english}
}

@techreport{rep-PIDsImplementation-26,
  title = {{{PIDs Implementation Guide}} for {{Institutions}}},
  author = {Almeida, Melroy and Croker, Kate and Devine, Gerry and Liffers, Matthias and McCafferty, Siobhann and Simons, Natasha and Stevens, Jackie and Werkman, Harko and Wilmann, Tania and Winton, Lyle},
